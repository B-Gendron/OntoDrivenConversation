                                <owl:onProperty rdf:resource="https://anonymous.org/ontologies/interview#inPhase"/>
                                <owl:hasValue rdf:resource="https://anonymous.org/ontologies/interview#phase3"/>
                            </owl:Restriction>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://anonymous.org/ontologies/interview#Utterance"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://anonymous.org/ontologies/interview#nextCharacteristic"/>
                <owl:hasValue rdf:resource="https://anonymous.org/ontologies/interview#non_loaded"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


