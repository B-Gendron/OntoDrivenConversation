    <!-- https://anonymous.org/ontologies/interview#characterizesUtterance -->

    <owl:ObjectProperty rdf:about="https://anonymous.org/ontologies/interview#characterizesUtterance">
        <owl:inverseOf rdf:resource="https://anonymous.org/ontologies/interview#hasCharacteristic"/>
        <rdfs:domain rdf:resource="https://anonymous.org/ontologies/interview#UtteranceCharacteristic"/>
        <rdfs:range rdf:resource="https://anonymous.org/ontologies/interview#Utterance"/>
    </owl:ObjectProperty>
    


    <!-- https://anonymous.org/ontologies/interview#hasCharacteristic -->

    <owl:ObjectProperty rdf:about="https://anonymous.org/ontologies/interview#hasCharacteristic">
