    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/user/ontologies/2023/10/utterances#hasPolarity -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/user/ontologies/2023/10/utterances#hasPolarity">
