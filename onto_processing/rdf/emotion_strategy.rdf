    <!-- http://www.semanticweb.org/user/ontologies/2023/10/utterances#LoadedNegativeIntention -->

    <owl:Class rdf:about="http://www.semanticweb.org/user/ontologies/2023/10/utterances#LoadedNegativeIntention">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/user/ontologies/2023/10/utterances#NextIntention"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/user/ontologies/2023/10/utterances#isInferredFromUtterance"/>
                        <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/user/ontologies/2023/10/utterances#LoadedPositiveUtterance"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2023/10/utterances#NextIntention"/>
    </owl:Class>
    


